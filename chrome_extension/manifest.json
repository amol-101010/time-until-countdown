{
  "manifest_version": 3,
  "name": "TimeUntil - Countdown Timer",
  "short_name": "TimeUntil",
  "description": "Countdown timer to any date or event with a live toolbar badge. See day, month, year and lifetime progress in dots.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
